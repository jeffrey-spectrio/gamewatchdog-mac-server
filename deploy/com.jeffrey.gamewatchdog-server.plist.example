<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.jeffrey.gamewatchdog-server</string>
  <key>ProgramArguments</key><array><string>/opt/homebrew/bin/node</string><string>/Users/YOU/gamewatchdog-mac-server/src/server.mjs</string></array>
  <key>WorkingDirectory</key><string>/Users/YOU/gamewatchdog-mac-server</string>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/YOU/Library/Logs/gamewatchdog-server.log</string>
  <key>StandardErrorPath</key><string>/Users/YOU/Library/Logs/gamewatchdog-server-error.log</string>
</dict></plist>
